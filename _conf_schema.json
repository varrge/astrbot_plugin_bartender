{
    "now_chats_name":{
        "description":"当前角色卡",
        "type": "string",
        "hint": "此处用于储存和查看当前角色卡，不要从此处修改当前角色卡",
        "invisible": "True",
        "default": "Seraphina"
    },
        "browser_ip":{
        "description":"酒馆地址",
        "type": "string",
        "hint": "用于配置链接酒馆的远程地址和协议",
        "default": "http://127.0.0.1"
    },
        "browser_port":{
        "description":"酒馆端口",
        "type": "string",
        "hint": "用于配置链接酒馆的远程端口",
        "default": "8000"
    },
    "browser_delay":{
        "description":"操作延迟",
        "type": "int",
        "hint": "每次点击和查找操作之间的延迟/单位毫秒",
        "default": "50"
    },
    "upload_interval":{
        "description":"角色卡间隔",
        "type": "int",
        "hint": "等待角色卡上传的间隔时间/单位秒",
        "default": "20"
    },
    "thread_safe_mode":{
        "description":"线程安全模式",
        "type": "bool",
        "hint": "开启后指令响应速度慢，弱加载浏览器不占内存，关闭后指令响应速度快，常加载浏览器避免反复加载浪费时间，有小概率出现多浏览器卡后台占内存，不懂如何看进程溢出的不要修改",
        "default": true
    },
    "browser_Visible":{
        "description":"浏览器无头模式",
        "type": "bool",
        "hint": "关闭后浏览器可视化，用于调试和查看加载状态",
        "default": false
    },
    "kill_Process":{
        "description":"杀进程指令开关",
        "type": "bool",
        "hint": "开启后允许使用杀进程指令，无差别清理所有chrome浏览器进程",
        "default": false
    },
    "allowed_group_ids":{
        "description":"允许使用的群",
        "type": "list",
        "items": {"type": "string"},
        "hint":"仅列表中的群可以使用调酒师指令",
        "default": ["1047134405"]
    },
    "admin_ids":{
        "description":"调酒师管理员",
        "type": "list",
        "items": {"type": "string"},
        "hint":"可以操作共享角色卡、楼层和浏览器的用户 ID",
        "default": ["3390201260", "49E92693D0363BAD7C92C4ED13CB6A88"]
    },
    "sillytavern_username":{
        "description":"SillyTavern 登录账户",
        "type": "string",
        "default": "default-user",
        "invisible": true
    },
    "sillytavern_password":{
        "description":"SillyTavern 登录密码",
        "type": "string",
        "default": "",
        "invisible": true
    }
}
